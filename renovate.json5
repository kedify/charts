
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":gitSignOff",
  ],
  "labels": ["renovate"],
  "prConcurrentLimit": 2,
  "ignorePaths": ["**/vendor/**"],
  // ignore everything except those that are white-listed
  "packageRules": [
    // Kubernetes rules copied from kedify/github-meta/kubernetes-versions.json.
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "rancher/k3s"
      ],
      "versioning": "regex:^v(?<major>1)\\.(?<compatibility>[0-9]+)\\.(?<patch>[0-9]+)-k3s(?<build>[0-9]+)$",
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "kindest/node"
      ],
      "versioning": "regex:^v(?<major>1)\\.(?<compatibility>[0-9]+)\\.(?<patch>[0-9]+)$",
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["rancher/k3s", "kindest/node", "kubernetes-sigs/kind"],
      "addLabels": ["version-bump"],
    },
    {
      "packagePatterns": ["*"],
      "enabled": false,
    },
    {
      "packageNames": [
        "ghcr.io/kedify/agent", // docker img
      ],
      // paused, because the image tag is being updated by PR from a gh action on agent's repo
      "enabled": false,
    },
    {
      "packageNames": [
        "ghcr.io/kedify/charts/otel-add-on", // OCI helm chart
      ],
      "enabled": true,
    },
    {
      "packageNames": [
        "ghcr.io/kedify/charts/kedify-predictor", // OCI helm chart
      ],
      "enabled": true,
    },
    {
      "packageNames": [
        "ghcr.io/kedify/charts/kpa",
        "ghcr.io/kedify/charts/autoscaling-checks",
        "ghcr.io/kedify/charts/kedify-observability",
      ],
      "enabled": true,
    },
    {
      "packageNames": [
        "envoyproxy/envoy", // docker img, kedify-proxy is a wrapper around it
      ],
      "enabled": true,
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["kindest/node"],
      "matchFileNames": ["scripts/kubernetes-versions.json"],
      "enabled": true,
      "pinDigests": true,
      "labels": ["dependencies", "kubernetes"],
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["kubernetes-sigs/kind"],
      "matchFileNames": [".github/workflows/**"],
      "enabled": true,
      "labels": ["dependencies", "kubernetes"],
    },
  ],
  "regexManagers": [
    // Shared managers, in this file's existing regexManagers format.
    {
      "fileMatch": [
        "(^|/)(kedify-)?kubernetes-versions\\.json$"
      ],
      "matchStrings": [
        "\"(?<depName>rancher/k3s|kindest/node):(?<currentValue>v1\\.[0-9]+\\.[0-9]+(?:-k3s[0-9]+)?)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": [
        "^\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=kubernetes-sigs/kind\\s+version: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      // kedify agent
      "fileMatch": ["^kedify-agent/values.yaml$"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kedify/agent",
      "matchStrings": [
        "tag:\\s+\"?(?<currentValue>[^\"\n]+)\"?\\s*\n",
      ],
    },
    {
      // kedify OTel Addon
      "fileMatch": ["^kedify-agent/Chart.yaml$"],
      "datasourceTemplate": "docker", // not a typo, OCI helm charts use 'docker' template
      "depNameTemplate": "ghcr.io/kedify/charts/otel-add-on",
      "matchStrings": [
        "name:\\s+otel-add-on\\s*\n\\s*repository:\\s+oci://ghcr.io/kedify/charts\\s*\n\\s+version:\\s+\"?(?<currentValue>[^\"\n]+)\"?\\s*\n",
      ],
    },
    {
      // kedify Predictor
      "fileMatch": ["^kedify-agent/Chart.yaml$"],
      "datasourceTemplate": "docker", // not a typo, OCI helm charts use 'docker' template
      "depNameTemplate": "ghcr.io/kedify/charts/kedify-predictor",
      "matchStrings": [
        "name:\\s+kedify-predictor\\s*\n\\s*repository:\\s+oci://ghcr.io/kedify/charts\\s*\n\\s+version:\\s+\"?(?<currentValue>[^\"\n]+)\"?\\s*\n",
      ],
    },
    {
      // OCI chart dependencies not covered by the release-triggered updater.
      "fileMatch": ["^kedify-agent/Chart.yaml$"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kedify/charts/{{{depName}}}",
      "matchStrings": [
        "name:\\s+(?<depName>kpa|autoscaling-checks|kedify-observability)\\s*\n\\s*repository:\\s+oci://ghcr.io/kedify/charts\\s*\n\\s+version:\\s+\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
    {
      // Envoy proxy (kedify-proxy appVersion doubles as the envoyproxy/envoy image tag)
      "fileMatch": ["^kedify-proxy/Chart.yaml$"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "envoyproxy/envoy",
      "matchStrings": [
        "appVersion:\\s+\"?(?<currentValue>[^\"\n]+)\"?\\s*\n",
      ],
    },
  ],
  "reviewers": ["team:all"],
  "prBodyNotes": [
    "Bump some versions we have inside our code",
  ],
}
